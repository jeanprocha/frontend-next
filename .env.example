# Clerk (autenticação) — obrigatórias para o app renderizar fora do bypass E2E.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Base URL do backend Go (Railway em produção).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Backend usado pelo proxy same-origin do dossiê público
# (src/app/api/public/simulation-records/[id]/route.ts). Opcional — sem ela,
# cai em NEXT_PUBLIC_API_URL.
ENGINE_BASE_URL=

# Fallback do plano PLG quando o usuário não tem tribia_plan em publicMetadata
# (free | pro | premium).
NEXT_PUBLIC_TRIBIA_PLG_TIER=free

# Bypass de auth SÓ para o smoke Playwright offline (FE-0) — nunca definir em
# .env.local nem em ambiente de deploy. Morto por construção em `next build`
# (NODE_ENV=production); ver src/lib/e2e-auth-bypass.ts.
# NEXT_PUBLIC_E2E_AUTH_BYPASS=1
